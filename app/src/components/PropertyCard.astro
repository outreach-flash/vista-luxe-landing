---
import { resolveImageVariants } from '../lib/media';

interface Props {
  slug: string;
  title: string;
  status?: string | null;
  price?: number | null;
  cardImage?: string | null;
  bedrooms?: string | null;
  bathrooms?: string | null;
  squareArea?: number | null;
}
const { slug, title, status, price, cardImage, bedrooms, bathrooms, squareArea } = Astro.props;
const cardSrc = cardImage ? (await resolveImageVariants(cardImage, { full: 800 })).full : null;
const fmt = (n: number) => n.toLocaleString('en-IN');
const stats = [
  bedrooms ? { icon: 'bed', text: bedrooms } : null,
  bathrooms ? { icon: 'bath', text: bathrooms } : null,
  squareArea != null ? { icon: 'area', text: `${fmt(squareArea)} sq ft` } : null,
].filter(Boolean) as { icon: string; text: string }[];
---

<a
  href={`/properties/${slug}`}
  class="prop-card group relative block overflow-hidden rounded-[20px] bg-mist"
  data-status={status}
  data-price={price}
  data-title={title.toLowerCase()}
>
  <div class="aspect-[4/3.4] w-full overflow-hidden rounded-[20px]" style={`view-transition-name: hero-${slug}`}>
    {cardSrc ? (
      <img
        src={cardSrc}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      />
    ) : (
      <div class="h-full w-full bg-white/10 flex items-center justify-center text-white/40 text-sm">No Image</div>
    )}
  </div>

  {status && (
    <span class="absolute right-4 top-4 flex items-center gap-1.5 rounded-full bg-white px-3.5 py-2 text-[12px] font-medium text-ink">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3 2 12h3v8h6v-6h2v6h6v-8h3z"/></svg>
      {status}
    </span>
  )}

  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent px-5 pb-6 pt-20">
    <h3 class="w-fit text-[17px] font-medium text-white" style={`view-transition-name: title-${slug}`}>{title}</h3>
    <p class="mt-1 text-[30px] font-bold tracking-tight text-white">{price != null ? `₹${fmt(price)}` : 'Price on Request'}</p>
    {stats.length > 0 && (
      <div class="mt-3 flex items-center gap-5 text-[13px] font-medium text-white/90">
        {stats.map((s, i) => (
          <span class="flex items-center gap-2">
            {i > 0 && <span class="h-4 w-px bg-white/30 mr-3"></span>}
            {s.icon === 'bed' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M2 20h20"/></svg>
            )}
            {s.icon === 'bath' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h16v2a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-2Z"/><path d="M6 12V5a2 2 0 0 1 4 0"/><path d="M8 21l-1 1M17 21l1 1"/></svg>
            )}
            {s.icon === 'area' && (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg>
            )}
            {s.text}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
