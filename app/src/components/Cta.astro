---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
---

<section class="px-3 md:px-5">
  <div class="cta-wrap relative overflow-hidden rounded-[28px]">
    <img src="/assets/img/lQ2c1tUqYlj0bLtzWgULCmgN7Q.png" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <div class="relative mx-auto max-w-[1320px] px-6 pt-24 text-center md:px-10 md:pt-32">
      <div class="flex justify-center">
        <Eyebrow text="Find your next home" />
      </div>
      <h2 class="h-display mx-auto mt-6 max-w-[700px] text-[38px] text-ink md:text-[56px]">
        Discover homes designed for your lifestyle
      </h2>
      <p class="mx-auto mt-5 max-w-[560px] text-[16px] leading-relaxed text-body">
        Explore properties, compare options, and move forward with confidence - everything you need in one place.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact-us" label="Get in Touch" variant="dark" />
      </div>
      <div class="mt-16 md:mt-20">
        <img
          src="/assets/img/nuTtmfD0U8YTAyaN05gJQw2XU.png"
          alt="Modern round house at dusk"
          class="cta-img mx-auto w-full max-w-[1240px] rounded-t-[28px] object-cover md:h-[520px]"
        />
      </div>
    </div>
  </div>
</section>
