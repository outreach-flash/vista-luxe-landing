---

---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300"
>
  <div
    class="mx-auto flex max-w-[1320px] items-center justify-between px-5 py-5 md:px-6 lg:px-8"
  >
    <a href="/" class="flex items-center gap-2">
      <img
        src="/assets/img/hpBPVJ4EDWe6VR2UVdlcckRzGFo.svg"
        alt="Vista Luxe"
        class="h-6 w-auto"
      />
      <span class="text-[22px] font-bold tracking-tight text-ink"
        >Vista Luxe</span
      >
    </a>

    <nav class="hidden items-center gap-9 md:flex">
      <a
        href="/properties"
        class="text-[13px] font-medium uppercase tracking-[0.08em] text-ink hover:opacity-60 transition-opacity"
        >Properties</a
      >
      <a
        href="/#services"
        class="text-[13px] font-medium uppercase tracking-[0.08em] text-ink hover:opacity-60 transition-opacity"
        >Services</a
      >
      <a
        href="/about-us"
        class="text-[13px] font-medium uppercase tracking-[0.08em] text-ink hover:opacity-60 transition-opacity"
        >About</a
      >
      <a
        href="/contact-us"
        class="group flex items-center gap-3 rounded-full bg-ink py-2 pl-5 pr-2 text-[13px] font-medium text-white transition-colors hover:bg-black"
      >
        Contact us
        <span
          class="flex h-7 w-7 items-center justify-center rounded-full bg-white text-ink transition-transform duration-300 group-hover:rotate-45"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"
            ><path
              d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </span>
      </a>
    </nav>

    <button
      id="menu-btn"
      class="flex h-10 w-10 items-center justify-center rounded-full bg-ink text-white md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" width="16" height="16" viewBox="0 0 16 16" fill="none"
        ><path
          d="M2 4h12M2 8h12M2 12h12"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path></svg
      >
      <svg
        id="icon-close"
        class="hidden"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        ><path
          d="M3 3l10 10M13 3L3 13"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute right-5 top-[68px] w-[min(340px,calc(100%-40px))] origin-top-right scale-95 rounded-3xl bg-white p-5 opacity-0 shadow-[0_20px_50px_rgba(0,0,0,0.15)] transition-all duration-200 md:hidden"
  >
    <nav class="flex flex-col">
      <a
        href="/properties"
        class="border-b border-line py-3.5 text-sm font-medium uppercase tracking-[0.08em]"
        >Properties</a
      >
      <a
        href="/#services"
        class="border-b border-line py-3.5 text-sm font-medium uppercase tracking-[0.08em]"
        >Services</a
      >
      <a
        href="/about-us"
        class="py-3.5 text-sm font-medium uppercase tracking-[0.08em]">About</a
      >
      <a
        href="/contact-us"
        class="mt-2 flex h-12 items-center justify-center rounded-full bg-ink text-sm font-medium text-white"
        >Contact us</a
      >
    </nav>
  </div>
</header>

<script>
  import { smoother } from "../lib/smoother";

  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add(
        "bg-white/90",
        "backdrop-blur-md",
        "shadow-[0_1px_0_rgba(0,0,0,0.06)]",
      );
    } else {
      header?.classList.remove(
        "bg-white/90",
        "backdrop-blur-md",
        "shadow-[0_1px_0_rgba(0,0,0,0.06)]",
      );
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const setMenu = (open: boolean) => {
    menu?.classList.toggle("opacity-0", !open);
    menu?.classList.toggle("scale-95", !open);
    menu?.classList.toggle("pointer-events-none", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
  };
  btn?.addEventListener("click", () =>
    setMenu(btn.getAttribute("aria-expanded") !== "true"),
  );
  menu
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("click", (e) => {
    if (!header?.contains(e.target as Node)) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  // Intercept anchor links to prevent native jumping with ScrollSmoother
  document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const href = this.getAttribute("href");
      if (!href) return;
      
      const targetId = href.replace(/^\//, "");
      if (targetId === "#") return;

      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        e.preventDefault();
        if (smoother) {
          smoother.scrollTo(targetElement, true, "top top");
        } else {
          targetElement.scrollIntoView({ behavior: "smooth" });
        }
        setMenu(false);
        history.pushState(null, "", href);
      }
    });
  });
</script>
