---
interface Props {
  href: string;
  label: string;
  variant?: 'dark' | 'outline' | 'light';
  class?: string;
}
const { href, label, variant = 'dark', class: cls = '' } = Astro.props;

const base = 'group inline-flex items-center gap-3 rounded-full py-2.5 pl-6 pr-2.5 text-[14px] font-medium transition-colors';
const variants = {
  dark: 'bg-ink text-white hover:bg-black',
  outline: 'border border-ink/20 bg-white/40 text-ink backdrop-blur-sm hover:border-ink/40',
  light: 'bg-white text-ink hover:bg-white/90',
};
const circle = {
  dark: 'bg-white text-ink',
  outline: 'bg-ink text-white',
  light: 'bg-ink text-white',
};
---

<a href={href} class:list={[base, variants[variant], cls]}>
  {label}
  <span class:list={['flex h-7 w-7 items-center justify-center rounded-full transition-transform duration-300 group-hover:rotate-45', circle[variant]]}>
    <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
</a>
