---
---

<footer class="bg-white px-3 pb-3 pt-6 md:px-5 md:pb-5">
  <div class="overflow-hidden rounded-[28px] bg-ink">
    <!-- giant wordmark over dusk image -->
    <div class="relative h-[340px] overflow-hidden md:h-[480px]">
      <img
        src="/assets/img/nuTtmfD0U8YTAyaN05gJQw2XU.png"
        alt="Modern home at dusk"
        class="absolute inset-0 h-full w-full object-cover brightness-[0.55]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-ink"></div>
      <div class="absolute inset-x-0 bottom-[-4%] text-center">
        <span
          class="bg-gradient-to-b from-white/90 to-white/5 bg-clip-text font-display text-[26vw] leading-[0.8] text-transparent md:text-[22vw]"
          >VISTA LUXE</span
        >
      </div>
    </div>

    <!-- footer content -->
    <div class="mx-auto max-w-[1240px] px-6 pb-8 pt-14 md:px-10 md:pt-20">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
        <div class="md:col-span-6">
          <a href="/" class="flex items-center gap-2">
            <img src="/assets/img/wtAazKz9ClT6GcQ95wWsMeO0LI.svg" alt="Vista Luxe" class="h-6 w-auto" />
            <span class="text-[22px] font-bold tracking-tight text-white">Vista Luxe</span>
          </a>
          <p class="mt-5 max-w-[300px] text-[15px] leading-relaxed text-white/70">
            Find, explore, and choose your next home with a simple and modern experience.
          </p>
          <div class="mt-7 flex items-center gap-4">
            <a href="#" aria-label="Instagram" class="text-white/80 transition-opacity hover:opacity-60">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4zm0 11a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm8.5-11.3a1.6 1.6 0 1 1-3.2 0 1.6 1.6 0 0 1 3.2 0z"/></svg>
            </a>
            <a href="#" aria-label="Facebook" class="text-white/80 transition-opacity hover:opacity-60">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.8V24C19.62 23.09 24 18.1 24 12.07z"/></svg>
            </a>
            <a href="#" aria-label="X" class="text-white/80 transition-opacity hover:opacity-60">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg>
            </a>
            <a href="#" aria-label="YouTube" class="text-white/80 transition-opacity hover:opacity-60">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.87.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
            </a>
          </div>
        </div>

        <div class="md:col-span-3">
          <h4 class="text-[15px] font-semibold text-white">Explore</h4>
          <ul class="mt-6 space-y-4 text-[15px] text-white/70">
            <li><a href="/properties" class="transition-opacity hover:opacity-60">Properties</a></li>
            <li><a href="/#services" class="transition-opacity hover:opacity-60">Services</a></li>
            <li><a href="/about-us" class="transition-opacity hover:opacity-60">About</a></li>
            <li><a href="/contact-us" class="transition-opacity hover:opacity-60">Contact Us</a></li>
          </ul>
        </div>

        <div class="md:col-span-3">
          <h4 class="text-[15px] font-semibold text-white">Contact</h4>
          <ul class="mt-6 space-y-4 text-[15px] text-white/70">
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-ink">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
              </span>
              hello@vistaluxe.com
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-ink">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              +123 456 000
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-ink">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              New York, USA
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-7 text-[13px] text-white/50 md:flex-row">
        <span>Copyright@2026</span>
        <span class="flex items-center gap-2">
          Crafted by
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-white/70"><path d="M4 4h7v7H4zM13 4h7l-7 7zM4 13l7-2v9H4zM13 13h7v7h-7z"/></svg>
        </span>
        <a href="#" class="transition-opacity hover:opacity-60">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
