---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
---

<Layout title="Contact Us — Vista Luxe" description="Whether you're looking to buy, rent, or just explore, we'll guide every step with clarity.">
  <section class="mx-auto max-w-[1320px] px-5 pt-28 md:px-6 lg:px-8 md:pt-32 lg:pt-44">
    <Eyebrow text="Contact Us" />
    <div class="mt-6 grid grid-cols-1 gap-8 md:grid-cols-2">
      <h1 class="h-display text-[28px] text-ink md:text-[52px]">Let's help you find the right home</h1>
      <p class="max-w-[420px] self-end text-[16px] leading-relaxed text-body md:justify-self-end">
        Whether you're looking to buy, rent, or just explore, we'll guide every step with clarity.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2">
      <!-- commitment card -->
      <div class="relative flex min-h-[480px] flex-col overflow-hidden rounded-2xl bg-ink p-9 md:min-h-[560px]">
        <img src="/assets/img/wtAazKz9ClT6GcQ95wWsMeO0LI.svg" alt="" class="h-10 w-auto" />
        <div class="mt-8 max-w-[380px]">
          <h2 class="text-[26px] font-bold tracking-tight text-white">Our Commitment</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-white/75">
            Helping you discover homes that truly match your lifestyle - with clarity, trust, and simplicity.
          </p>
        </div>
        <img
          src="/assets/img/qFdT9uikjTH2yp4jiz8Oy1EeV4.png"
          alt="House illustration"
          class="pointer-events-none absolute -bottom-4 left-1/2 w-[86%] -translate-x-1/2 object-contain"
        />
      </div>

      <!-- form -->
      <form id="contact-form" class="rounded-2xl bg-mist p-8 md:p-10">
        <div class="flex flex-col gap-5">
          <div>
            <label for="cf-name" class="text-[13px] font-medium text-ink">Full Name <span class="text-red-500">*</span></label>
            <input id="cf-name" required type="text" placeholder="Jhon Doe"
              class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3.5 text-[14px] outline-none placeholder:text-body/50 focus:border-ink/30" />
          </div>
          <div>
            <label for="cf-email" class="text-[13px] font-medium text-ink">Email <span class="text-red-500">*</span></label>
            <input id="cf-email" required type="email" placeholder="jhon@gamil.cpm"
              class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3.5 text-[14px] outline-none placeholder:text-body/50 focus:border-ink/30" />
          </div>
          <div>
            <label for="cf-subject" class="text-[13px] font-medium text-ink">Subject</label>
            <input id="cf-subject" type="text" placeholder="Enter subject..."
              class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3.5 text-[14px] outline-none placeholder:text-body/50 focus:border-ink/30" />
          </div>
          <div>
            <label for="cf-message" class="text-[13px] font-medium text-ink">Message <span class="text-red-500">*</span></label>
            <textarea id="cf-message" required rows="4" placeholder="Enter your message..."
              class="mt-2 w-full resize-none rounded-xl border border-line bg-white px-4 py-3.5 text-[14px] outline-none placeholder:text-body/50 focus:border-ink/30"></textarea>
          </div>
          <button type="submit" class="mt-2 w-full rounded-full bg-ink py-4 text-[15px] font-medium text-white transition-colors hover:bg-black">
            Submit
          </button>
          <p id="form-note" class="hidden text-center text-[13px] text-green-700">Thanks! We'll get back to you soon.</p>
        </div>
      </form>
    </div>

    <!-- map -->
    <div class="mt-5 overflow-hidden rounded-2xl">
      <iframe
        title="New York Office, Broadway"
        src="https://maps.google.com/maps?q=Broadway%2C%20New%20York%2C%20NY&t=&z=14&ie=UTF8&iwloc=&output=embed"
        class="h-[420px] w-full border-0 grayscale-[35%]"
        loading="lazy"
      ></iframe>
    </div>
  </section>

  <Faq />
  <Cta />
</Layout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('form-note')?.classList.remove('hidden');
    (e.target as HTMLFormElement).reset();
  });
</script>
