---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map((p) => ({ params: { slug: p.id }, props: { property: p } }));
}

const { property } = Astro.props;
const d = property.data;

/** Format a number as Indian Rupees */
function formatINR(n: number) {
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0,
  }).format(n);
}

/** Render an area pair: "12.5 sq m / 134.5 sq ft" — omits units with no value */
function formatArea(area?: { sqM?: number | null; sqFt?: number | null } | null) {
  if (!area) return null;
  const parts: string[] = [];
  if (area.sqM != null) parts.push(`${area.sqM.toLocaleString('en-IN')} sq m`);
  if (area.sqFt != null) parts.push(`${area.sqFt.toLocaleString('en-IN')} sq ft`);
  return parts.length ? parts.join(' / ') : null;
}

const areaRows: { label: string; value: string | null }[] = [
  { label: 'Plot Area', value: formatArea(d.plotArea) },
  { label: 'Net Effective Area', value: formatArea(d.netEffectiveArea) },
  { label: 'Ground Floor Area', value: formatArea(d.groundFloorArea) },
  { label: 'First Floor Area', value: formatArea(d.firstFloorArea) },
  { label: 'Total Floor Area', value: formatArea(d.totalFloorArea) },
  { label: 'Plot + Road & Common Area', value: formatArea(d.plotRoadCommonArea) },
  { label: 'Built-up Area', value: formatArea(d.builtUpArea) },
  { label: 'Entrance + Deck + Verandah + Balconies', value: formatArea(d.entranceDeckVerandahBalconies) },
  { label: 'Double Height Area', value: formatArea(d.doubleHeightArea) },
  { label: 'Half Area of Terrace', value: formatArea(d.halfAreaOfTerrace) },
  { label: 'Swimming Pool', value: formatArea(d.swimmingPool) },
  { label: '33% Lawn Area', value: formatArea(d.lawnArea33Percent) },
  { label: 'Total Super Area', value: formatArea(d.totalSuperArea) },
  { label: 'Carpet Area', value: formatArea(d.carpetArea) },
  { label: 'Terrace Area', value: formatArea(d.terraceArea) },
  { label: 'Pool Deck Area', value: formatArea(d.poolDeckArea) },
  { label: 'Private Pool & Garden Area', value: d.privatePoolAndGarden ? formatArea(d.privatePoolAndGardenArea) : null },
  { label: 'Total Super Built-up Area', value: formatArea(d.totalSuperBuiltUpArea) },
].filter((r) => r.value !== null);

const specRows: { label: string; value: string }[] = [
  d.configuration ? { label: 'Configuration', value: d.configuration } : null,
  d.bedrooms ? { label: 'Bedrooms', value: d.bedrooms } : null,
  d.bathrooms ? { label: 'Bathrooms', value: d.bathrooms } : null,
  d.numberOfBalconies != null ? { label: 'Number of Balconies', value: String(d.numberOfBalconies) } : null,
  d.parking ? { label: 'Parking', value: d.parking } : null,
  d.numberOfFloors != null ? { label: 'Number of Floors', value: String(d.numberOfFloors) } : null,
  d.squareArea != null ? { label: 'Square Area', value: `${d.squareArea.toLocaleString('en-IN')} sq ft` } : null,
  d.yearBuilt != null ? { label: 'Year Built', value: String(d.yearBuilt) } : null,
  d.propertyType ? { label: 'Property Type', value: d.propertyType } : null,
  d.privatePoolAndGarden ? { label: 'Private Pool + Garden', value: 'Yes' } : null,
].filter(Boolean) as { label: string; value: string }[];

const hasFloors = d.floors && d.floors.length > 0;
const hasAreaRows = areaRows.length > 0;
const hasProximity = d.proximityLocations && d.proximityLocations.length > 0;
const hasAmenities = d.amenities && d.amenities.length > 0;
const hasFloorPlan = !!d.floorPlan;

/** Combined gallery: images first, then videos */
const mediaItems = [
  ...(d.gallery ?? []).map((src) => ({ type: 'image' as const, src })),
  ...(d.galleryVideos ?? []).map((src) => ({ type: 'video' as const, src })),
];
const hasGallery = mediaItems.length > 0;
const galleryCountLabel = (d.galleryVideos?.length ?? 0) > 0 ? 'photos & videos' : 'photos';
---

<Layout title={`${d.title} — Vista Luxe`} description={d.description ?? d.title}>
  <section class="mx-auto max-w-[1320px] px-6 pt-32 md:px-10 md:pt-44">
    {d.status && (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-mist px-4 py-2 text-[13px] font-medium text-ink">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3 2 12h3v8h6v-6h2v6h6v-8h3z"/></svg>
        {d.status}
      </span>
    )}

    <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="h-display w-fit max-w-full text-[40px] text-ink md:text-[56px]" style={`view-transition-name: title-${property.id}`}>{d.title}</h1>
        {(d.street || d.area || d.city) && (
          <p class="mt-4 flex items-center gap-2 text-[15px] text-body">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {[d.street, d.area, d.city].filter(Boolean).join(', ')}
          </p>
        )}
      </div>

      <!-- Pricing -->
      <div class="flex flex-col items-end gap-2">
        <p class="text-[36px] font-bold tracking-tight text-ink md:text-[48px]">{d.price != null ? formatINR(d.price) : 'Price on Request'}</p>
        {d.semiFurnishedPrice != null && (
          <p class="text-[14px] text-body">
            Semi-Furnished: <span class="font-semibold text-ink">{formatINR(d.semiFurnishedPrice)}</span>
          </p>
        )}
        {d.fullyFurnishedPrice != null && (
          <p class="text-[14px] text-body">
            Fully Furnished: <span class="font-semibold text-ink">{formatINR(d.fullyFurnishedPrice)}</span>
          </p>
        )}
      </div>
    </div>

    <!-- Gallery -->
    {hasGallery && (
      <div class="relative mt-10">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
          <div class="relative overflow-hidden rounded-2xl md:col-span-8 cursor-pointer group" id="open-gallery-main" style={`view-transition-name: hero-${property.id}`}>
            {mediaItems[0].type === 'video' ? (
              <>
                <video src={mediaItems[0].src} muted loop playsinline preload="metadata" class="h-full max-h-[560px] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                  <span class="flex h-16 w-16 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
                  </span>
                </span>
              </>
            ) : (
              <img src={mediaItems[0].src} alt={d.title} class="h-full max-h-[560px] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            )}
          </div>
          {mediaItems.length > 1 && (
            <div class="flex flex-col gap-4 md:col-span-4">
              {mediaItems.slice(1, 3).map((m, idx) => (
                <div class="relative flex-1 overflow-hidden rounded-2xl cursor-pointer group open-gallery-thumb" data-index={idx + 1}>
                  {m.type === 'video' ? (
                    <>
                      <video src={m.src} muted loop playsinline preload="metadata" class="h-full max-h-[272px] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
                        </span>
                      </span>
                    </>
                  ) : (
                    <img src={m.src} alt={d.title} loading="lazy" class="h-full max-h-[272px] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  )}
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- "View all photos" button -->
        <button
          type="button"
          id="open-gallery-btn"
          class="absolute bottom-5 right-5 inline-flex items-center gap-2 rounded-xl bg-ink/80 px-4 py-2.5 text-[14px] font-medium text-white shadow-lg backdrop-blur-md transition-all hover:bg-ink hover:scale-105"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
            <circle cx="9" cy="9" r="2"/>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
          </svg>
          <span>View all {mediaItems.length} {galleryCountLabel}</span>
        </button>

        <!-- Translucent Overlay Lightbox -->
        <div
          id="gallery-modal"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 backdrop-blur-md p-4 transition-opacity duration-300 opacity-0"
          role="dialog"
          aria-modal="true"
          aria-label="Photo gallery"
        >
          <!-- Header controls -->
          <div class="absolute top-4 right-4 z-10 flex items-center gap-4">
            <span id="gallery-counter" class="text-sm font-medium tracking-wide text-white/70">
              1 / {mediaItems.length}
            </span>
            <button
              type="button"
              id="close-gallery-btn"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
              aria-label="Close gallery"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <!-- Nav previous button -->
          {mediaItems.length > 1 && (
            <button
              type="button"
              id="prev-photo-btn"
              class="absolute left-4 top-1/2 z-10 -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 hover:scale-110"
              aria-label="Previous photo"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
            </button>
          )}

          <!-- Main Photo/Video Container -->
          <div class="flex h-full w-full max-w-5xl flex-col items-center justify-center">
            <div class="relative flex max-h-[75vh] w-full items-center justify-center">
              <img
                id="gallery-active-img"
                src={mediaItems[0].type === 'image' ? mediaItems[0].src : undefined}
                alt={d.title}
                class:list={["max-h-[75vh] max-w-full rounded-xl object-contain shadow-2xl transition-all duration-200 select-none", { hidden: mediaItems[0].type === 'video' }]}
              />
              <video
                id="gallery-active-video"
                src={mediaItems[0].type === 'video' ? mediaItems[0].src : undefined}
                controls
                playsinline
                class:list={["max-h-[75vh] max-w-full rounded-xl shadow-2xl", { hidden: mediaItems[0].type !== 'video' }]}
              />
            </div>

            <!-- Thumbnail Strip (if multiple photos) -->
            {mediaItems.length > 1 && (
              <div class="mt-4 flex max-w-full gap-2 overflow-x-auto pb-2 px-2 scrollbar-thin">
                {mediaItems.map((m, i) => (
                  <button
                    type="button"
                    class="gallery-thumbnail relative shrink-0 overflow-hidden rounded-lg border-2 border-transparent transition opacity-60 hover:opacity-100"
                    data-thumb-index={i}
                  >
                    {m.type === 'video' ? (
                      <>
                        <video src={m.src} muted playsinline preload="metadata" class="h-14 w-20 object-cover" />
                        <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="white" class="drop-shadow"><path d="M8 5.5v13l11-6.5z"/></svg>
                        </span>
                      </>
                    ) : (
                      <img src={m.src} alt="" class="h-14 w-20 object-cover" />
                    )}
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- Nav next button -->
          {mediaItems.length > 1 && (
            <button
              type="button"
              id="next-photo-btn"
              class="absolute right-4 top-1/2 z-10 -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 hover:scale-110"
              aria-label="Next photo"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </button>
          )}
        </div>
      </div>
    )}

    <!-- Content + sticky card -->
    <div class="mt-16 grid grid-cols-1 gap-12 pb-24 lg:grid-cols-12">
      <div class="lg:col-span-7">

        <!-- Description -->
        {d.description && (
          <>
            <h2 class="text-[28px] font-medium tracking-tight text-ink">Description</h2>
            <p class="mt-4 text-[15px] leading-[1.8] text-body">{d.description}</p>
          </>
        )}

        <!-- Key Specs -->
        {specRows.length > 0 && (
          <div class="mt-10">
            <div class="mt-5">
              {specRows.map((s) => (
                <div class="flex items-center justify-between border-b border-line py-4 last:border-0">
                  <span class="text-[15px] text-body">{s.label}</span>
                  <span class="text-[15px] font-semibold text-ink">{s.value}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Area Breakdown -->
        {hasAreaRows && (
          <div class="mt-10">
            <h2 class="text-[28px] font-medium tracking-tight text-ink">Area Breakdown</h2>
            <div class="mt-5">
              {areaRows.map((r) => (
                <div class="flex items-center justify-between border-b border-line py-4 last:border-0">
                  <span class="text-[15px] text-body">{r.label}</span>
                  <span class="text-[15px] font-semibold text-ink">{r.value}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Floors -->
        {hasFloors && (
          <div class="mt-10">
            <h2 class="text-[28px] font-medium tracking-tight text-ink">Floors</h2>
            <div class="mt-5 flex flex-col gap-4">
              {d.floors!.map((floor) => (
                <div class="rounded-xl bg-mist px-5 py-4">
                  <p class="text-[15px] font-semibold text-ink">{floor.label}</p>
                  {floor.description && (
                    <p class="mt-1 text-[14px] leading-relaxed text-body">{floor.description}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Amenities -->
        {hasAmenities && (
          <div class="mt-10">
            <h2 class="text-[28px] font-medium tracking-tight text-ink">Amenities & Features</h2>
            <div class="mt-5 flex flex-wrap gap-2.5">
              {d.amenities.map((a) => (
                <span class="rounded-lg bg-mist px-5 py-2.5 text-[14px] font-medium text-ink">{a}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Floor Plans -->
        {hasFloorPlan && (
          <div class="mt-10">
            <h2 class="text-[28px] font-medium tracking-tight text-ink">Floor Plans</h2>
            <div class="mt-5 overflow-hidden rounded-2xl">
              <img src={d.floorPlan!} alt={`${d.title} floor plan`} loading="lazy" class="w-full object-cover" />
            </div>
          </div>
        )}

        <!-- Proximity Locations -->
        {hasProximity && (
          <div class="mt-10">
            <h2 class="text-[28px] font-medium tracking-tight text-ink">Nearby Locations</h2>
            <div class="mt-5">
              {d.proximityLocations!.map((loc) => (
                <div class="flex items-center justify-between border-b border-line py-4 last:border-0">
                  <span class="flex items-center gap-2.5 text-[15px] text-body">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    {loc.location}
                  </span>
                  <span class="text-[15px] font-semibold text-ink">{loc.distance}</span>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Pinned contact card (ScrollTrigger pin; sticky breaks under ScrollSmoother) -->
      <div class="lg:col-span-5" id="detail-side-col">
        <div id="detail-card" class="rounded-2xl bg-ink p-9 text-center">
          <img src="/assets/img/wtAazKz9ClT6GcQ95wWsMeO0LI.svg" alt="" class="mx-auto h-12 w-auto" />
          <h3 class="mt-6 text-[26px] font-bold tracking-tight text-white">Like this property?</h3>
          <p class="mt-3 text-[14px] leading-relaxed text-white/70">
            We'd love to help you explore this home. Reach out to get more details or book a visit.
          </p>
          <div class="mt-7 flex flex-col gap-3">
            {['Verified Property Listings', 'Quality Living Spaces', 'Smart Real Estate Choice'].map((t) => (
              <div class="flex items-center gap-3 rounded-xl bg-white/10 px-5 py-3.5 text-left text-[14px] font-medium text-white">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="shrink-0"><path d="m5 13 4 4L19 7"/></svg>
                {t}
              </div>
            ))}
          </div>
          <a
            href="/contact-us"
            class="group mt-8 inline-flex items-center gap-3 rounded-full bg-white py-2.5 pl-6 pr-2.5 text-[14px] font-medium text-ink transition-colors hover:bg-white/90"
          >
            Get More Details
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink text-white transition-transform duration-300 group-hover:rotate-45">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Faq />
  <Cta />

  <script is:inline define:vars={{ mediaItems }}>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('gallery-modal');
      if (!modal || !mediaItems || mediaItems.length === 0) return;
      // fixed overlays must live outside ScrollSmoother's transformed content
      document.body.appendChild(modal);

      let currentIndex = 0;
      const activeImg = document.getElementById('gallery-active-img');
      const activeVideo = document.getElementById('gallery-active-video');
      const counter = document.getElementById('gallery-counter');
      const thumbs = document.querySelectorAll('.gallery-thumbnail');

      function pauseVideo() {
        if (activeVideo && !activeVideo.paused) activeVideo.pause();
      }

      function updateGallery(index) {
        if (index < 0) index = mediaItems.length - 1;
        if (index >= mediaItems.length) index = 0;
        currentIndex = index;

        const item = mediaItems[currentIndex];
        pauseVideo();
        if (item.type === 'video') {
          if (activeImg) activeImg.classList.add('hidden');
          if (activeVideo) {
            activeVideo.src = item.src;
            activeVideo.classList.remove('hidden');
          }
        } else {
          if (activeVideo) {
            activeVideo.classList.add('hidden');
            activeVideo.removeAttribute('src');
            activeVideo.load();
          }
          if (activeImg) {
            activeImg.src = item.src;
            activeImg.classList.remove('hidden');
          }
        }
        if (counter) {
          counter.textContent = `${currentIndex + 1} / ${mediaItems.length}`;
        }

        thumbs.forEach((thumb, i) => {
          if (i === currentIndex) {
            thumb.classList.remove('opacity-60', 'border-transparent');
            thumb.classList.add('opacity-100', 'border-white');
          } else {
            thumb.classList.remove('opacity-100', 'border-white');
            thumb.classList.add('opacity-60', 'border-transparent');
          }
        });
      }

      function openModal(index = 0) {
        updateGallery(index);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        // Trigger transition
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        });
      }

      function closeModal() {
        pauseVideo();
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      // Open triggers
      document.getElementById('open-gallery-btn')?.addEventListener('click', () => openModal(0));
      document.getElementById('open-gallery-main')?.addEventListener('click', () => openModal(0));
      document.querySelectorAll('.open-gallery-thumb').forEach((el) => {
        el.addEventListener('click', () => {
          const idx = parseInt(el.getAttribute('data-index') || '0', 10);
          openModal(idx);
        });
      });

      // Close triggers
      document.getElementById('close-gallery-btn')?.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal || (e.target instanceof HTMLElement && e.target.classList.contains('flex-col'))) {
          closeModal();
        }
      });

      // Nav triggers
      document.getElementById('prev-photo-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateGallery(currentIndex - 1);
      });
      document.getElementById('next-photo-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateGallery(currentIndex + 1);
      });

      // Thumb clicks
      thumbs.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute('data-thumb-index') || '0', 10);
          updateGallery(idx);
        });
      });

      // Keyboard controls
      document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'ArrowLeft') updateGallery(currentIndex - 1);
        if (e.key === 'ArrowRight') updateGallery(currentIndex + 1);
      });
    });
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from '../../lib/smoother';

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const card = document.getElementById('detail-card');
      const col = document.getElementById('detail-side-col');
      if (!card || !col) return;
      const grid = col.parentElement!;
      ScrollTrigger.create({
        trigger: card,
        start: 'top 112px',
        end: () => '+=' + Math.max(0, grid.offsetHeight - card.offsetHeight),
        pin: true,
        pinSpacing: false,
      });
    });
  </script>
</Layout>

