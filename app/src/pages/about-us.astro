---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';

const tickerImgs = [
  '/assets/img/5Vxo16bNUTl6ZclqgomJdW5Q.png',
  '/assets/img/dJ7fWLlvgxhbTwk9okaVDZFG7JA.jpeg',
  '/assets/img/fzQ2xS2V9QmSJmALiGNMih6TWYU.png',
  '/assets/img/KJ8VlLuAo5JRrMqlrZ6SuEFJIQ.png',
  '/assets/img/kgO0bckgo4wHvesBw5PMbiFiD2I.png',
];

const stats = [
  { label: 'Total Value', target: '4.6', prefix: '₹', suffix: 'M+' },
  { label: 'Active Homes', target: '320', prefix: '', suffix: '+' },
  { label: 'Happy Clients', target: '98', prefix: '', suffix: '%' },
];
---

<Layout title="About Us — Vista Luxe" description="We help people discover, explore, and choose homes with clarity - combining design, data, and a modern real estate experience.">
  <!-- ============ HERO ============ -->
  <section class="mx-auto max-w-[1320px] px-6 pt-32 md:px-10 md:pt-44">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <div>
        <Eyebrow text="About Us" />
        <h1 class="mt-6 text-[40px] font-semibold leading-[1.1] tracking-[-0.03em] text-ink md:text-[56px]">Discover homes that fit your lifestyle</h1>
        <p class="mt-5 max-w-[460px] text-[18px] leading-relaxed text-body">
          We help people discover, explore, and choose homes with clarity - combining design, data, and a modern real estate experience.
        </p>
        <div class="reveal mt-10 overflow-hidden rounded-[20px]">
          <video
            src="/assets/vid/rI2dEovMPm3NHSgDR5vB8RrdGs.mp4"
            autoplay muted loop playsinline
            class="aspect-[1.85] w-full object-cover"
          ></video>
        </div>
      </div>
      <div>
        <div class="reveal overflow-hidden rounded-[20px]">
          <img src="/assets/img/4HL0fzFRq5ePZ1mpJXpZ4a4y5Y.png" alt="A-frame modern home" class="aspect-[603/521] w-full object-cover" />
        </div>
        <!-- clients strip sits under the right column, like the reference -->
        <div class="mt-8 flex items-center gap-6">
          <span class="shrink-0 text-[14px] uppercase tracking-normal text-body">Our Clients</span>
          <div class="min-w-0 flex-1">
            <ClientLogos />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SMARTER CHOICES (Homy Quote) ============ -->
  <section class="mt-24 bg-mist2 py-16 md:mt-32 md:py-[72px]">
    <div class="mx-auto grid max-w-[1320px] grid-cols-1 items-center gap-8 px-6 md:grid-cols-2 md:px-10">
      <h2 class="reveal max-w-[560px] text-[34px] font-medium leading-[1.4] text-ink">Smarter choices behind every home decision</h2>
      <p class="reveal max-w-[596px] text-[18px] font-medium leading-[1.6] text-body md:justify-self-end">
        Designed to make your home search simple, clear, and more confident at every step, helping you explore properties with better understanding and make decisions that truly fit your lifestyle.
      </p>
    </div>
  </section>

  <!-- ============ MISSION / VISION ============ -->
  <section id="mission-section" class="px-3 pb-24 pt-24 md:px-5 md:pb-32 md:pt-32">
    <div id="mission-block" class="relative w-full">
      <div class="overflow-hidden rounded-[20px]">
        <video
          src="/assets/vid/Bg3JpCFVhXQn97VzoZ1IHBgQMBg.mp4"
          autoplay muted loop playsinline
          class="h-[420px] w-full object-cover md:h-[560px] lg:h-[680px]"
        ></video>
      </div>
      <div class="mt-5 flex flex-col justify-center gap-5 px-1 md:absolute md:inset-x-0 md:bottom-[22px] md:mt-0 md:flex-row md:px-6">
        <div class="w-full rounded-[15px] bg-black/20 p-[25px] backdrop-blur-[10px] md:max-w-[428px]">
          <h3 class="text-[28px] font-medium text-white">Our Mission</h3>
          <p class="mt-2 line-clamp-2 text-[18px] font-medium leading-[1.4] text-[#f5f5f5]">
            To make home discovery simple, clear, and accessible - helping people explore properties with confidence and make decisions without confusion.
          </p>
        </div>
        <div class="w-full rounded-[15px] bg-black/20 p-[25px] backdrop-blur-[10px] md:max-w-[428px]">
          <h3 class="text-[28px] font-medium text-white">Our Vision</h3>
          <p class="mt-2 line-clamp-2 text-[18px] font-medium leading-[1.4] text-[#f5f5f5]">
            To create a modern real estate experience where finding the right home feels effortless, transparent, and truly aligned with how people live today.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST & CONFIDENCE (stats bento + photo ticker) ============ -->
  <section class="mx-auto max-w-[1320px] px-6 pb-24 md:px-10 md:pb-32">
    <Eyebrow text="Trust & Confidence" />
    <div class="mt-6 grid grid-cols-1 gap-8 md:grid-cols-2">
      <h2 class="reveal text-[34px] font-semibold leading-[1.15] tracking-[-0.02em] text-ink md:text-[48px]">Confidence behind every property decision</h2>
      <p class="reveal max-w-[520px] self-end text-[18px] leading-relaxed text-body md:justify-self-end">
        Built to make modern home discovery simple, transparent, and more confident for every user.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-3 lg:min-h-[800px] lg:grid-cols-[305px_1fr_275px]">
      <!-- LEFT: stats + CTA card -->
      <div class="flex flex-col gap-3">
        <div class="reveal flex flex-col gap-3 rounded-3xl bg-mist2 p-3">
          <p class="px-3 pt-3 text-[16px] font-medium text-[#262626]">Real Results</p>
          {stats.map((s) => (
            <div class="flex flex-1 flex-col justify-center rounded-2xl bg-white px-6 py-6">
              <p class="text-[14px] text-body">{s.label}</p>
              <p
                class="stat-value mt-1 text-[36px] font-semibold tracking-tight text-ink"
                data-target={s.target}
                data-prefix={s.prefix}
                data-suffix={s.suffix}
              >
                {s.prefix}0{s.suffix}
              </p>
            </div>
          ))}
        </div>
        <div class="reveal flex flex-1 flex-col overflow-hidden rounded-3xl bg-mist2 p-6">
          <h3 class="text-center text-[22px] font-medium leading-[1.35] text-[#191919]">Built for Better Living</h3>
          <p class="mt-2 text-center text-[14px] leading-relaxed text-body">
            We do more than list homes - we create a smoother way to discover spaces that feel right for your lifestyle.
          </p>
          <div class="relative mt-4 min-h-[90px] flex-1 overflow-hidden rounded-xl">
            <img src="/assets/img/7kuxPVTjMLe1PbETJGXV0BIBB6s.png" alt="Modern home exterior" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            <a
              href="/contact-us"
              class="absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-[13px] font-semibold text-white transition-opacity hover:opacity-85"
            >
              Contact Us
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7h9M7.5 3l4 4-4 4"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- CENTER: portrait + guidance overlay -->
      <div class="reveal relative min-h-[480px] overflow-hidden rounded-3xl">
        <img src="/assets/img/fIyAjnZ2gAZdn550oqGHb6GoSzA.png" alt="Confident homeowner" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-8 md:p-10">
          <h3 class="max-w-[460px] text-[28px] font-medium leading-[1.3] text-white md:text-[34px]">Guidance you can trust in your home search</h3>
          <p class="mt-3 max-w-[460px] text-[15px] leading-relaxed text-white/80">
            With the right expertise and a clear approach, explore homes with confidence and move closer to finding a space that truly fits your lifestyle.
          </p>
        </div>
      </div>

      <!-- RIGHT: heading + vertical photo ticker -->
      <div class="flex flex-col">
        <h3 class="reveal text-[22px] font-medium leading-[1.4] text-[#191919]">Loved by people who found their home</h3>
        <div id="photo-ticker" class="reveal relative mt-5 min-h-[400px] flex-1 overflow-hidden rounded-2xl lg:min-h-0">
          <div id="photo-ticker-track" class="flex flex-col gap-3 will-change-transform lg:absolute lg:inset-x-0 lg:top-0">
            {[...tickerImgs, ...tickerImgs].map((src) => (
              <img src={src} alt="Happy homeowners" loading="lazy" class="h-[170px] w-full shrink-0 rounded-2xl object-cover" />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq />
  <Cta />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import '../lib/smoother';
  gsap.registerPlugin(ScrollTrigger);
  gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
    gsap.fromTo(el,
      { scale: 0.9, y: 20, opacity: 0 },
      {
        scale: 1, y: 0, opacity: 1, ease: 'none',
        scrollTrigger: { trigger: el, start: 'top 95%', end: 'top 60%', scrub: true },
      }
    );
  });

  const missionBlock = document.getElementById('mission-block');
  if (missionBlock) {
    gsap.fromTo(missionBlock,
      { scale: 0.7 },
      {
        scale: 1, ease: 'none',
        scrollTrigger: { trigger: '#mission-section', start: 'top 95%', end: 'top 45%', scrub: true },
      }
    );
  }

  /* ---- stat counters ---- */
  gsap.utils.toArray<HTMLElement>('.stat-value').forEach((el) => {
    const target = parseFloat(el.dataset.target || '0');
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const isFloat = String(el.dataset.target).includes('.');
    const obj = { v: 0 };
    ScrollTrigger.create({
      trigger: el, start: 'top 88%', once: true,
      onEnter: () =>
        gsap.to(obj, {
          v: target, duration: 1.6, ease: 'power2.out',
          onUpdate: () => {
            el.textContent = prefix + (isFloat ? obj.v.toFixed(1) : Math.round(obj.v).toString()) + suffix;
          },
        }),
    });
  });

  /* ---- vertical photo ticker: continuous upward drift (~40px/s) ---- */
  const tickerTrack = document.getElementById('photo-ticker-track');
  if (tickerTrack) {
    const startTicker = () => {
      const half = tickerTrack.scrollHeight / 2;
      if (half <= 0) return;
      gsap.fromTo(tickerTrack, { y: 0 }, { y: -half, duration: half / 40, ease: 'none', repeat: -1 });
    };
    startTicker();
    window.addEventListener('resize', () => {
      gsap.killTweensOf(tickerTrack);
      gsap.set(tickerTrack, { y: 0 });
      startTicker();
    });
  }

  // Font swaps can change line counts after window load; re-measure trigger positions.
  document.fonts?.ready.then(() => ScrollTrigger.refresh());
</script>
